# Whitelist-only gitignore: ignore everything by default, then
# explicitly un-ignore only the dotfiles/configs we want to track.
# When adding a new file inside an already-allowed directory, you must
# also add an explicit "!" rule for it here (git won't recurse into
# an ignored path unless every ancestor is un-ignored too).

# Deny everything at the root by default
/*

# Shell config
!/.bashrc
!/.bash_profile
!/.bash_logout
!/.profile
!/.zshrc

# Claude Code
!/.claude.json
!/.claude.local.json
!/.claude/
/.claude/*
!/.claude/AGENTS.md
!/.claude/settings.json
!/.claude/settings.local.json
!/.claude/.claude.json
!/.claude/themes/
!/.claude/skills/
/.claude/skills/.trash
/.claude/skills/synced
!/.claude/agents/

# Codex
!/.codex/
/.codex/*
!/.codex/config.toml
!/.codex/AGENTS.md
!/.codex/skills/
!/.codex/agents/
/.codex/skills/.system/

# Cursor config
#!/.cursor/
#/.cursor/*
#/.cursor/projects/
#/.cursor/plugins/
#!/.cursor/skills/
#!/.cursor/agents/

# Opencode
!/.config
/.config/*
!/.config/opencode
/.config/opencode/*
!/.config/opencode/AGENTS.md
!/.config/opencode/opencode.json
!/.config/opencode/settings.json
!/.config/opencode/skills/
!/.config/opencode/agents/
!/.config/opencode/commands/

#Cross-platform agents/skills folder (ulis-managed)
!/.agents/
